# ── Hyperledger Fabric ─────────────────────────────
FABRIC_ORG_MSP=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_ORDERER_ENDPOINT=localhost:7050
FABRIC_CHANNEL_NAME=healthchannel
FABRIC_CHAINCODE_NAME=accessControl
FABRIC_CRYPTO_PATH=../fabric-network/crypto-config
FABRIC_TLS_CERT_PATH=../fabric-network/crypto-config/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_CERT_PATH=../fabric-network/crypto-config/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_DIR=../fabric-network/crypto-config/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/

# ── JWT ────────────────────────────────────────────
JWT_SECRET=<generate with: openssl rand -hex 32>
JWT_EXPIRY=3600
REFRESH_SECRET=<generate with: openssl rand -hex 32>
REFRESH_TOKEN_EXPIRY=604800

# ── App Server ─────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zkhealthpass
POSTGRES_USER=zkuser
POSTGRES_PASSWORD=<strong-password>

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_PROOF=20

# ── Circuit Paths ──────────────────────────────────
CIRCUIT_WASM_PATH=./src/circuits/access_control.wasm
CIRCUIT_ZKEY_PATH=./src/circuits/access_control_final.zkey
CIRCUIT_VKEY_PATH=./src/circuits/verification_key.json
